rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }
    match /users_private/{uid} {
      allow read: if verifiedOwner(uid);
      allow create: if verifiedOwner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time;
      allow update: if verifiedOwner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    // Conteúdo público, papéis, matrículas, respostas e dados antigos não foram migrados.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

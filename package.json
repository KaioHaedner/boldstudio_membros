{
  "name": "boldstudio-membros",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Plataforma de videoaulas BOLDSTUDIO — area de membros + LP + admin",
  "scripts": {
    "dev": "vite",
    "dev:firebase": "vite --mode firebase --host 127.0.0.1 --port 5174",
    "test:firebase-rules": "node --test tests/firebase-rules.test.mjs",
    "test:media": "node --test tests/card-swipe.test.mjs tests/stacked-carousel.test.mjs tests/media-budget.test.mjs tests/media-proxy.test.mjs",
    "build": "tsc -b && node scripts/generate-service-video-sitemap.mjs && vite build && node scripts/generate-service-seo.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@supabase/supabase-js": "^2.106.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "devices.css": "^0.2.0",
    "firebase": "^12.19.0",
    "framer-motion": "^12.40.0",
    "globe.gl": "^2.46.2",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.3",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
